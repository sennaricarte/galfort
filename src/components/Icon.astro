---
// Ícones em SVG inline: zero requisições extras e sem dependência dos arquivos .webp do site antigo.
interface Props { name: 'whatsapp' | 'phone' | 'arrow' | 'instagram' | 'facebook' | 'linkedin' | 'anos' | 'personalizado' | 'durabilidade'; size?: number }
const { name, size = 24 } = Astro.props;
---
